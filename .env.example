DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=joyeria_app
DB_PASSWORD=
DB_NAME=joyeria_pena

# Pon "true" si tu MySQL requiere SSL (por ejemplo Aiven u otro proveedor en
# la nube). Cuando está en true, se usa el certificado en db/aiven-ca.pem.
DB_SSL=false

# Clave para firmar la cookie de sesión. Genera una propia, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
